{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:best-practices"],
  "timezone": "UTC",
  "dependencyDashboard": true,
  "enabledManagers": ["pep621", "github-actions", "pre-commit", "custom.regex"],

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)(Dockerfile|\\.github/workflows/[^/]+\\.ya?ml)$/"],
      "matchStrings": [
        "ARG UV_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\" # renovate: uv"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],

  "pre-commit": {
    "enabled": true
  },

  // ---------------------------------------------------------------------------
  // GLOBAL DEFAULTS (Template)
  // Applied across all managers, including pep621, github-actions, and pre-commit
  // ---------------------------------------------------------------------------
  "labels": ["dependencies"],
  "reviewers": ["team:anta-maintainers"],
  "commitMessagePrefix": "ci:",
  "semanticCommits": "enabled",

  // Global operational rules
  "minimumReleaseAge": "7 days",
  // Let Renovate update its branches after autofix.ci commits formatting changes.
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "lockFileMaintenance": {
    "enabled": true,
    "rebaseWhen": "behind-base-branch"
  },

  "packageRules": [
    // -------------------------------------------------------------------------
    // PEP621 (pyproject.toml) Rules
    // Inherits global: reviewers, commitMessagePrefix ("ci:"), labels ("dependencies")
    // -------------------------------------------------------------------------
    {
      "description": "Runtime dependencies lower bounds.",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Disable build-system and requires-python updates.",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["build-system.requires", "requires-python"],
      "enabled": false
    },
    {
      "description": "Bump range shape for dependency groups.",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "rangeStrategy": "bump"
    },
    // -------------------------------------------------------------------------
    // CI Tools (GitHub Actions & pre-commit)
    // Inherits global: reviewers, commitMessagePrefix ("ci:")
    // Overrides: labels -> ["CI"]
    // -------------------------------------------------------------------------
    {
      "description": "Pin GitHub Actions digests.",
      "matchManagers": ["github-actions"],
      "labels": ["CI"],
      "pinDigests": true
    },
    {
      "description": "Handling hook rev autoupdates.",
      "matchManagers": ["pre-commit"],
      "matchDepTypes": ["repository"],
      "enabled": true
    },
    {
      "description": "Update pre-commit Python additional_dependencies only.",
      "matchManagers": ["pre-commit"],
      "matchDepTypes": ["pre-commit-python"],
      "labels": ["CI"],
      "rangeStrategy": "bump"
    },
    // Share the group across managers so duplicated PyPI dependencies update together.
    // Tool-specific groups below override this default for hook repository aliases.
    {
      "description": "Group non-major Python tooling updates across Python and pre-commit.",
      "matchManagers": ["pep621", "pre-commit"],
      "matchDepTypes": ["dependency-groups", "pre-commit-python"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python tooling dependencies",
      "groupSlug": "python-tooling"
    },
    {
      "description": "Group Ruff updates across Python and pre-commit",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Ruff",
      "groupSlug": "ruff"
    },
    {
      "description": "Group Pylint updates across Python and pre-commit",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["pylint", "pycqa/pylint"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Pylint",
      "groupSlug": "pylint"
    },
    {
      "description": "Group codespell updates across Python and pre-commit",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["codespell", "codespell-project/codespell"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "codespell",
      "groupSlug": "codespell"
    },
    {
      "description": "Keep uv pins within the repository's supported range.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["astral-sh/uv"],
      "allowedVersions": "<0.13",
      "labels": ["CI"],
      "schedule": ["before 5am on monday"]
    },

    // -------------------------------------------------------------------------
    // Governance & Security
    // -------------------------------------------------------------------------
    {
      "description": "Gate major updates behind the Dependency Dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
